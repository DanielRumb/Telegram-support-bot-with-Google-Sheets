    {
      "parameters": {
        "content": "## Task 2 \nAnalysis of sales managers' performance)",
        "width": 288
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -624,
        -160
      ],
      "typeVersion": 1,
      "id": "ffbb556a-b6ca-401c-9229-6df63585e2b6",
      "name": "Sticky Note1"
    },
    {
      "parameters": {
        "jsCode": "// Берём ВСЕХ лидов (для подсчёта конверсии)\nconst leads = $('Search records').all().map(i => i.json.fields);\n\n// Берём заказы с менеджерами\nconst orders = $input.all().map(i => i.json.fields);\n\n// 1. Считаем количество лидов на каждого менеджера\nconst leadCounts = {};\nfor (const l of leads) {\n  const m = l.manager;\n  leadCounts[m] = (leadCounts[m] || 0) + 1;\n}\n\n// 2. Считаем сумму продаж и кол-во заказов на каждого менеджера\nconst managerStats = {};\nfor (const o of orders) {\n  const m = o.manager;\n  if (!managerStats[m]) managerStats[m] = { full_sum: 0, order_count: 0 };\n  managerStats[m].full_sum += Number(o.total_sum);\n  managerStats[m].order_count += 1;\n}\n\n// 3. Собираем итоговую таблицу по всем менеджерам\nconst result = Object.keys(leadCounts).map(manager => {\n  const stats = managerStats[manager] || { full_sum: 0, order_count: 0 };\n  const leadCount = leadCounts[manager];\n  const conversion = leadCount > 0 ? stats.order_count / leadCount : 0;\n  return {\n    manager,\n    full_sum: stats.full_sum,\n    conversion: Number(conversion.toFixed(2)),\n  };\n});\n\n// 4. Сортируем по full_sum и помечаем 3 худших на увольнение\nresult.sort((a, b) => a.full_sum - b.full_sum);\nresult.forEach((r, idx) => {\n  r.fire = idx < 3 ? 'Yes' : 'No';\n});\n\nreturn result.map(r => ({ json: r }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        -32
      ],
